# Parameters for the image build.  These are loaded by the Justfile
# (set dotenv-filename := "image-template.env") and by GitHub Actions.

# Output image name, usually the same as the repository name.
IMAGE_NAME=aurora-cmpunlocker

# Make this the same as your GitHub username/organisation.
REPO_ORGANIZATION="nymacro"

IMAGE_DESC="Aurora nvidia-open with cmpunlocker-patched NVIDIA open kernel modules for the CMP 170HX"
IMAGE_KEYWORDS="bootc,oci,linux,aurora,nvidia,cmpunlocker"

# Optional logo used by https://artifacthub.io/. Leave blank to omit it.
IMAGE_LOGO_URL=""

DEFAULT_TAG="stable"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# Pinned, mutually compatible build inputs.  See README.md's compatibility
# matrix before changing these: the NVIDIA userspace and kernel module versions
# must match exactly, and cmpunlocker must support that driver release.
BASE_TAG="stable-44.20260922.1"
AKMODS_TAG="coreos-testing-44-7.1.10-200.fc44.x86_64"
CMPUNLOCKER_REF="v0.5"
EXPECTED_NVIDIA_VERSION="615.71.09"
